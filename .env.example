# Application Configuration
APP_NAME=ENDCOM.NET AI Assistant
APP_VERSION=1.0.0
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./tammy.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost/tammy

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin section (/admin) - shared password gating the built-in data
# dashboard. Leave blank to disable that legacy dashboard entirely.
ADMIN_PASSWORD=

# Supabase Auth - lets the Next.js frontend (web/) authenticate against
# this API via Supabase session tokens. From the Supabase Dashboard:
# Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# The deployed Next.js frontend's URL (no trailing slash) - used to send
# the browser back to the right place after connecting a calendar.
FRONTEND_URL=

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
EMAIL_FROM=tammy@yourcompany.com

# Google Calendar sync (optional) - from a Google Cloud OAuth 2.0 Client
# (console.cloud.google.com/apis/credentials) with the Calendar API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365/Outlook calendar sync (optional) - from an Azure AD app
# registration (portal.azure.com) with Graph's Calendars.ReadWrite permission.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Twilio for SMS/Call (optional)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Telnyx for SIP/Call (optional)
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_PUBLIC_KEY=your-telnyx-public-key-for-webhook-verification
TELNYX_PHONE_NUMBER=+1234567890

# Telephony - which carrier adapter handles calls (twilio | telnyx)
TELEPHONY_PROVIDER=telnyx
# Public HTTPS base URL this app is reachable at (needed for Twilio webhook
# signature verification behind a proxy/load balancer, e.g. https://api.endcom.net)
PUBLIC_BASE_URL=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Timezone
DEFAULT_TIMEZONE=UTC

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tammy.log
